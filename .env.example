# Cashflow IQ — Environment variables
# Copy to .env and fill in values before running.

# ── Postgres ──────────────────────────────────────
POSTGRES_USER=cashflowiq
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=cashflowiq
DATABASE_URL=postgresql://cashflowiq:localdevpassword@postgres:5432/cashflowiq

# ── API ───────────────────────────────────────────
JWT_SECRET=local-dev-secret-do-not-use-in-prod

# ── Dashboard ─────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
